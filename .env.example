# Telegram bot token from @BotFather.
TG__TOKEN=123456:ABCDEF

# Public base URL Telegram can reach this service at (no trailing path).
TG__WEBHOOK_URL=https://tg.channels.example.com

# Path the webhook is registered + served on (optional, has a default).
TG__WEBHOOK_ENDPOINT=/webhook/telegram

# Shared secret echoed back by Telegram in the
# X-Telegram-Bot-Api-Secret-Token header (optional but recommended).
TG__WEBHOOK_SECRET_TOKEN=change-me

# Optional outbound proxy for all Telegram API calls (http or socks5).
# PROXY_URL=socks5://user:pass@host:1080

# Server bind address (optional, defaults shown).
APP_HOST=0.0.0.0
APP_PORT=8080
